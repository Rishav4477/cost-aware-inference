# Local demo key only. Generate real keys with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
DEMO_API_KEY=local-demo-key-change-me
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me

# Public web sandbox. Leave disabled for normal API deployments.
PUBLIC_DEMO_ENABLED=false
PUBLIC_DEMO_TENANT_ID=public-demo
PUBLIC_DEMO_PROVIDER_KEY=replace-with-a-random-secret-at-least-16-characters
# Optional comma-separated provider simulators to force down, e.g. aws,azure.
PUBLIC_DEMO_FAIL_CLOUDS=
